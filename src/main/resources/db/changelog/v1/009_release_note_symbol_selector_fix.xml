<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="009" author="zor07">
        <insert tableName="release_notes">
            <column name="message">Исправлена ошибка из-за которой в веб-панели нельзя было выбрать больше 100 инструментов для мониторинга.</column>
            <column name="sent" valueBoolean="false"/>
            <column name="created_at" valueComputed="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
