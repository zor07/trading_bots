<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="012" author="zor07">
        <addColumn tableName="users">
            <column name="bot_type" type="varchar(10)" defaultValue="PRICE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropUniqueConstraint tableName="users" constraintName="users_chat_id_key"/>
        <addUniqueConstraint tableName="users" columnNames="chat_id, bot_type" constraintName="users_chat_id_bot_type_key"/>
    </changeSet>

</databaseChangeLog>
