<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="010" author="zor07">
        <insert tableName="release_notes">
            <column name="message">Добавлен алерт на всплеск открытого интереса (OI). Настройки доступны в веб-панели: порог срабатывания и период агрегации.</column>
            <column name="sent" valueBoolean="false"/>
            <column name="created_at" valueComputed="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
